# ── Django ──────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-string
DJANGO_SETTINGS_MODULE=nepal_aq.settings.development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgis://aq_user:aq_password@db:5432/nepal_aq_db
# For development without PostGIS:
# DATABASE_URL=postgres://aq_user:aq_password@db:5432/nepal_aq_db

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Belauri Data Paths ───────────────────────────────────────────────────────
BELAURI_DATA_DIR=/data/Belauri
OPENAQ_DATA_DIR=/data/open-aq

# ── Email (optional) ─────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Static / Media ───────────────────────────────────────────────────────────
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/mediafiles
