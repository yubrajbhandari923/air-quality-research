# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-use-a-long-random-string
DJANGO_SETTINGS_MODULE=nepal_aq.settings.development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
# Docker Compose Postgres (host machine connects on localhost:5432)
DATABASE_URL=postgres://aq_user:aq_password@localhost:5432/nepal_aq_db

# ── Cloudflare R2 (leave blank for local dev — uploads save to disk instead) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nepal-aq

# ── Data paths (for load_real_data command) ───────────────────────────────────
BELAURI_DATA_DIR=/path/to/Data/Belauri
OPENAQ_DATA_DIR=/path/to/Data/open-aq

# ── Archive ───────────────────────────────────────────────────────────────────
ARCHIVE_AFTER_DAYS=90
